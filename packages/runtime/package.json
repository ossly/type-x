{
  "name": "@type-x/runtime",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @type-x/types build && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "pnpm --filter @type-x/types build && tsc --noEmit",
    "test": "pnpm run build && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@type-x/types": "workspace:*",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@type-x/eslint-config": "workspace:*",
    "@type-x/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
