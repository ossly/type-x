{
  "name": "@type-x/types",
  "version": "0.2.1",
  "description": "Shared runtime-facing types for @type-x/cli and @type-x/runtime",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
