{
  "name": "@type-x/cli",
  "version": "0.4.0",
  "description": "A simple CLI runtime for installable command packages",
  "type": "module",
  "bin": {
    "x": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @type-x/runtime build && tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "smoke": "pnpm run build && node dist/src/cli.js hello",
    "lint": "eslint . --max-warnings 0",
    "check-types": "pnpm --filter @type-x/runtime build && tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "coverage": "pnpm run build && node --experimental-test-coverage --test test/*.test.mjs"
  },
  "devDependencies": {
    "@type-x/eslint-config": "workspace:*",
    "@type-x/types": "workspace:*",
    "@type-x/typescript-config": "workspace:*",
    "@types/node": "^18.19.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@type-x/runtime": "workspace:*"
  }
}
